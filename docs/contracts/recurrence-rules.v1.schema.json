{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$comment": "Contract version 1. Host-attributed contribution identity is external to the payload. Unknown properties are ignored.",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "dates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "pattern": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekdays",
        "Weekly",
        "Monthly",
        "MonthlyWeekday",
        "MonthlyLastDay",
        "Yearly"
      ]
    },
    "interval": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "default": 1
    }
  },
  "title": "Calendar recurrence-rules contribution v1",
  "required": [
    "title"
  ],
  "oneOf": [
    {
      "required": [
        "dates"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "pattern"
            ]
          },
          {
            "required": [
              "interval"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "pattern"
      ],
      "not": {
        "required": [
          "dates"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "pattern"
        ],
        "properties": {
          "pattern": {
            "const": "Weekdays"
          }
        }
      },
      "then": {
        "properties": {
          "interval": {
            "const": 1
          }
        }
      }
    }
  ]
}

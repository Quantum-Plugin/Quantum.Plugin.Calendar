{
  "id": "quantum.plugin.calendar",
  "version": "5.0.0",
  "entryAssembly": "Quantum.CalendarPlugin.dll",
  "database": {
    "migrations": "./migrations"
  },
  "ui": {
    "routes": [
      {
        "path": "/plugins/calendar",
        "component": "Quantum.OfficialPlugins.Calendar.UI.Pages.Calendar",
        "title": "\u65e5\u5386",
        "titles": {
          "en-US": "Calendar"
        },
        "icon": "\u65e5",
        "order": 100,
        "showInNavigation": true,
        "iconFile": "icons/plugin.ico"
      }
    ]
  },
  "web": {
    "head": [
      "<link rel=\"stylesheet\" href=\"_content/quantum.plugin.calendar/Quantum.CalendarPlugin.bundle.scp.css\">"
    ],
    "postBlazor": []
  },
  "capabilities": {
    "provides": [
      "calendar.event.create",
      "calendar.event.created",
      "calendar.event.delete",
      "calendar.event.deleted",
      "calendar.event.get",
      "calendar.event.list",
      "calendar.event.update",
      "calendar.event.updated",
      "calendar.task.create",
      "calendar.task.created",
      "calendar.task.delete",
      "calendar.task.deleted",
      "calendar.task.get",
      "calendar.task.list",
      "calendar.task.update",
      "calendar.task.updated",
      "calendar.task.set-completed",
      "calendar.mobile-page.refresh",
      "calendar.entry.list",
      "calendar.entry.get"
    ],
    "notifications": {
      "calendar.event.created": {
        "description": "A calendar event was created.",
        "messageSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
